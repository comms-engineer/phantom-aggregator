LOG_LEVEL=INFO
DATA_DIR=/app/data
CONFIG_DIR=/app/config
SOURCE_SYNC_INTERVAL_SECONDS=60
RAW_DATA_MAX_AGE_DAYS=14
SYSTEM_HEALTH_PAGE_NAME=system.page
CRITICAL_ALERT_K_INDEX_THRESHOLD=5
LXMF_ALERTING_ENABLED=false
# JSON arrays are supported for tuple-based settings.
# LXMF_ALERT_DESTINATIONS=["destination_hash"]
# LXMF_ALERT_COMMAND=["sideband","send","--destination","{address}","--message","{message}"]
NOMADNET_LINE_LIMIT=80
NOMADNET_MAX_LINES=80
